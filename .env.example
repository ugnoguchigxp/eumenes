EUMENES_DB=./data/eumenes.sqlite3
EUMENES_HOST=127.0.0.1
EUMENES_PORT=8787
# Optional: local API auth is generated and stored when empty.
EUMENES_API_TOKEN=
EUMENES_ORIGIN=http://127.0.0.1:5173
# Canvasアプリの別サイト・ループバックプレビューを有効にする場合
# EUMENES_CANVAS_PREVIEW_PORT=8790
# Optional ContextStill public MCP connection. Inject the MCP token in the backend environment.
EUMENES_CONTEXT_STILL_MCP_URL=
EUMENES_CONTEXT_STILL_MCP_TOKEN=
# Optional saved cloud LLM resource for SKILL selection only.
EUMENES_KNOWLEDGE_SELECTION_RESOURCE_ID=
# Export LARM_API_TOKEN in the shell; do not copy the secret here.
LARM_CONTROL_TOKEN=
LARM_PROFILE=ornith1.5Strix
LARM_AUDIENCE=saaa-desktop
EUMENES_TTS_VOICE=

# Structured JSONL diagnostics; default file is next to the DB in logs/api.jsonl.
EUMENES_LOG_LEVEL=info
# Set to - for stderr only. Change to debug to include successful GET requests.
EUMENES_LOG_FILE=

# Optional developer/fork override; official desktop releases include their own client file.
# Use the JSON downloaded for a Google OAuth Desktop app (not Web app).
# See docs/google-accounts.md. User account tokens are not part of this file.
EUMENES_GOOGLE_DESKTOP_CLIENT_FILE=
