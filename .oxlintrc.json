{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"unicorn/prefer-array-flat-map": "error"
	},
	"ignorePatterns": [
		"node_modules/**",
		"dist/**",
		"dist-web/**",
		"coverage/**",
		"data/**",
		"verification-reports/**",
		"test-results/**",
		"playwright-report/**",
		".serena/**"
	],
	"overrides": [
		{
			// The design system builds ARIA widgets (listbox, combobox, group, status)
			// on layout elements whose CSS depends on the tag; native elements would
			// change their rendering.
			"files": ["packages/design-system/**"],
			"rules": { "jsx-a11y/prefer-tag-over-role": "off" }
		}
	]
}
