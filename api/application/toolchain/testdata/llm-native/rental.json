{
	"version": 1,
	"title": "機材レンタルの契約条件",
	"scope": "個人契約の年齢制限と保証金を確認する",
	"requirements": [
		{
			"id": "age",
			"statement": "個人契約で必要な最低年齢を確認する",
			"required": true,
			"applicability": "個人として契約する依頼",
			"allowNotApplicable": false,
			"valueSchema": {
				"type": "integer",
				"minimum": 0,
				"maximum": 120
			}
		},
		{
			"id": "deposit",
			"statement": "個人契約で必要な保証金と通貨を確認する",
			"required": true,
			"applicability": "個人として契約する依頼",
			"allowNotApplicable": false,
			"valueSchema": {
				"type": "object",
				"properties": {
					"amount": {
						"type": "number",
						"minimum": 0
					},
					"currency": {
						"type": "string",
						"enum": ["JPY"],
						"maxLength": 3
					}
				},
				"required": ["amount", "currency"],
				"additionalProperties": false
			}
		}
	],
	"provenance": {
		"kind": "user"
	}
}
