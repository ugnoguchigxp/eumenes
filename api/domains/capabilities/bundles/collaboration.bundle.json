			],
			"dependencies": ["package:collaboration.pipeline@1"],
			"packageRevisionId": "package:collaboration.pipeline@1",
			"functionName": "collaborate_pipeline",
			"examples": [
				"複数の担当を使う今回の手順を、一緒に作ってから実行したい",
				"手順の二つ目だけ変えて、確認してから実行したい",
				"この依頼の進め方を下書きにして相談しながら直そう"
			],
			"redirects": [],
			"bindingRevisionId": "binding:collaboration.pipeline@1",
