		{
			"kind": "toolchain",
			"id": "web.research",
			"revision": 1,
			"title": "詳しいWeb調査",
			"summary": "複数資料の比較、相反する情報、原因や仮説の検証など、考えながら調査を続ける必要がある依頼を担当する。単一の事実をすぐ確認する場合はWeb検索を使う",
			"aliases": [],
			"tags": [],
			"useWhen": [
				"複数の資料を照合して比較・判断の根拠を整理したい",
