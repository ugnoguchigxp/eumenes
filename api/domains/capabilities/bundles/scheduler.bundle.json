		{
			"kind": "toolchain",
			"id": "scheduler.manage",
			"revision": 1,
			"title": "実行予約",
			"summary": "日時を指定して会話での回答を予約する。単発・固定間隔の予約の条件を対話で決める。",
			"aliases": [],
			"tags": ["予約", "定期実行"],
			"useWhen": [
				"指定日時にこの会話で知らせる、問いかける、文章で回答する仕事を予約したい",
				"同じ会話の仕事を決まった間隔で繰り返し予約したい"
			],
			"avoidWhen": [
				"経過時間を計るタイマーやストップウォッチを使いたい",
				"保存済みワークフローの予約を有効にしたい",
				"時刻を指定せず今すぐ回答が欲しい"
			],
			"dependencies": ["package:scheduler.collaborator@1"],
			"packageRevisionId": "package:scheduler.collaborator@1",
			"functionName": "schedule_conversation",
			"examples": [
				"明日の午前8時に、この会話で持ち物を確認するよう声をかけて",
				"毎晩21時に、この会話で一日の振り返りを促して",
				"来週の月曜の昼に、次の読書会のテーマ案をこの会話に出して"
			],
