{
	"formatVersion": 1,
	"bundleId": "settings-service-tests",
	"pins": [],
	"definitions": [],
	"bindings": [],
	"artifacts": [
		{
			"kind": "artifact",
			"id": "settings.service-tests",
			"revision": 6,
			"title": "動作確認",
			"variants": [
				{
					"id": "standard",
					"label": "標準",
					"definition": {
						"view": "service-test-workspace",
						"title": "サービスを試す",
						"statusSource": "service-tests-status",
						"catalogSource": "service-tests-catalog",
						"runsSource": "service-tests-runs",
						"healthSource": "service-tests-health"
					}
				}
			],
			"defaultVariant": "standard",
			"sourceBindings": [
				{
					"source": "service-tests-status",
					"adapterRef": "adapter:service-tests@1",
					"query": "query:service-tests.status@1",
					"target": "none"
				},
				{
					"source": "service-tests-catalog",
					"adapterRef": "adapter:service-tests@1",
					"query": "query:service-tests.catalog@1",
					"target": "none"
				},
				{
					"source": "service-tests-runs",
					"adapterRef": "adapter:service-tests@1",
					"query": "query:service-tests.runs@1",
					"target": "none"
				},
				{
					"source": "service-tests-health",
					"adapterRef": "adapter:service-tests@1",
					"query": "query:service-tests.health@1",
					"target": "none"
				},
				{
					"source": "service-tests-targets",
					"adapterRef": "adapter:service-tests@1",
					"query": "query:service-tests.targets@1",
					"target": "none"
				}
			],
			"actionBindings": [
				{
					"actionId": "refresh",
					"eventAction": "collection-refresh",
					"source": "service-tests-status",
					"operationId": "service-tests.refresh",
					"inputSchemaRef": "builtin:emptyInput",
					"effect": "write",
					"label": "一覧を更新",
					"rowInput": {}
				},
				{
					"actionId": "diagnose",
					"eventAction": "collection-diagnose",
					"source": "service-tests-status",
					"operationId": "service-tests.diagnose",
					"inputSchemaRef": "builtin:emptyInput",
					"effect": "write",
					"label": "Healthを確認",
					"rowInput": {}
				},
				{
					"actionId": "start",
					"eventAction": "collection-start",
					"source": "service-tests-catalog",
					"operationId": "service-tests.start",
					"inputSchemaRef": "schema:service-tests-start@2",
					"effect": "write",
					"label": "試す",
					"rowInput": {
						"targetId": "$row.id",
						"revision": "$row.revision"
					}
				},
				{
					"actionId": "start-custom",
					"eventAction": "collection-start-custom",
					"source": "service-tests-catalog",
					"operationId": "service-tests.start",
					"inputSchemaRef": "schema:service-tests-start@2",
					"effect": "write",
					"label": "条件を指定して試す"
				},
				{
					"actionId": "cancel",
					"eventAction": "collection-cancel",
					"source": "service-tests-runs",
					"operationId": "service-tests.cancel",
					"inputSchemaRef": "schema:service-tests-run@1",
					"effect": "write",
					"label": "中止",
					"rowInput": {
						"runId": "$row.id"
					}
				},
				{
					"actionId": "retry-artifact",
					"eventAction": "collection-retry-artifact",
					"source": "service-tests-runs",
					"operationId": "service-tests.retry-artifact",
					"inputSchemaRef": "schema:service-tests-run@1",
					"effect": "write",
					"label": "結果を再取得",
					"rowInput": {
						"runId": "$row.id"
					}
				}
			],
			"launcher": {
				"icon": "checks",
				"label": "動作確認",
				"group": "管理と確認",
				"order": 70,
				"description": "サービスの一覧 試用 Health確認"
			},
			"collections": [
				{
					"source": "service-tests-status",
					"title": "サービスの一覧",
					"rowKey": "id",
					"columns": [
						{
							"key": "state",
							"label": "一覧の状態"
						},
						{
							"key": "discoveredAt",
							"label": "最終確認",
							"format": "date"
						},
						{
							"key": "targetCount",
							"label": "サービス数",
							"format": "number"
						},
						{
							"key": "control",
							"label": "LARM制御APIのHealth"
						},
						{
							"key": "refresh",
							"label": "更新"
						},
						{
							"key": "refreshGeneration",
							"label": "更新世代",
							"format": "number"
						},
						{
							"key": "errors",
							"label": "エラー"
						},
						{
							"key": "busy",
							"label": "処理中",
							"format": "boolean"
						},
						{
							"key": "catalogRevision",
							"label": "設定版",
							"format": "number"
						},
						{
							"key": "diagnosisRevision",
							"label": "診断時の設定版",
							"format": "number"
						},
						{
							"key": "diagnosisPhase",
							"label": "診断の段階"
						}
					],
					"rowActions": [
						{
							"actionId": "refresh",
							"requiresCleanDraft": "document:settings@1"
						},
						{
							"actionId": "diagnose",
							"confirm": "全サービスのHealthを確認します。時間がかかることがあります。",
							"requiresCleanDraft": "document:settings@1"
						}
					],
					"refreshWhile": {
						"key": "busy",
						"in": [true]
					}
				},
				{
					"source": "service-tests-catalog",
					"title": "試せるサービス",
					"rowKey": "id",
					"columns": [
						{
							"key": "name",
							"label": "サービス"
						},
						{
							"key": "model",
							"label": "モデル"
						},
						{
							"key": "kind",
							"label": "種類"
						},
						{
							"key": "kindCode",
							"label": "種類コード"
						},
						{
							"key": "source",
							"label": "接続先"
						},
						{
							"key": "sourceName",
							"label": "送信先"
						},
						{
							"key": "sourceCode",
							"label": "接続先コード"
						},
						{
							"key": "primary",
							"label": "代表Profile",
							"format": "boolean"
						},
						{
							"key": "onDemand",
							"label": "実行時起動",
							"format": "boolean"
						},
						{
							"key": "start",
							"label": "起動"
						},
						{
							"key": "state",
							"label": "試用"
						},
						{
							"key": "sample",
							"label": "サンプル"
						},
						{
							"key": "voiceInput",
							"label": "声入力可",
							"format": "boolean"
						}
					],
					"rowActions": [
						{
							"actionId": "start",
							"when": {
								"key": "testable",
								"in": [true]
							},
							"form": {
								"fields": [
									{
										"fieldId": "text",
										"label": "文章",
										"control": "textarea",
										"maxLength": 4096,
										"when": {
											"key": "kindCode",
											"in": ["llm", "tts", "embedding"]
										}
									},
									{
										"fieldId": "text",
										"label": "文章",
										"control": "textarea",
										"maxLength": 4096,
										"when": {
											"key": "kindCode",
											"in": ["decision"]
										},
										"help": "入力が「挨拶」か「質問・依頼」かを判定します。"
									},
									{
										"fieldId": "text",
										"label": "プロンプト",
										"control": "textarea",
										"maxLength": 4096,
										"when": {
											"key": "kindCode",
											"in": ["image"]
										}
									},
									{
										"fieldId": "text",
										"label": "曲の説明",
										"control": "textarea",
										"maxLength": 4096,
										"when": {
											"key": "kindCode",
											"in": ["music"]
										}
									},
									{
										"fieldId": "comparison",
										"label": "比較する文章",
										"control": "textarea",
										"maxLength": 4096,
										"when": {
											"key": "kindCode",
											"in": ["embedding"]
										},
										"defaultValue": "窓のそばで猫が寝ています。"
									},
									{
										"fieldId": "voice",
										"label": "声のID（空欄で既定の声）",
										"control": "text",
										"maxLength": 128,
										"when": {
											"key": "voiceInput",
											"in": [true]
										}
									},
									{
										"fieldId": "width",
										"label": "幅（px）",
										"control": "number",
										"min": 100,
										"max": 1280,
										"when": {
											"key": "kindCode",
											"in": ["image"]
										},
										"defaultValue": "512"
									},
									{
										"fieldId": "height",
										"label": "高さ（px）",
										"control": "number",
										"min": 100,
										"max": 1280,
										"when": {
											"key": "kindCode",
											"in": ["image"]
										},
										"defaultValue": "512"
									},
									{
										"fieldId": "format",
										"label": "形式",
										"control": "select",
										"options": [
											{
												"value": "png",
												"label": "PNG"
											},
											{
												"value": "webp",
												"label": "WebP"
											}
										],
										"when": {
											"key": "kindCode",
											"in": ["image"]
										},
										"defaultValue": "webp"
									},
									{
										"fieldId": "durationSeconds",
										"label": "長さ（秒）",
										"control": "select",
										"valueType": "number",
										"when": {
											"key": "kindCode",
											"in": ["music"]
										},
										"defaultValue": "10",
										"options": [
											{
												"value": "5",
												"label": "5秒"
											},
											{
												"value": "10",
												"label": "10秒"
											},
											{
												"value": "20",
												"label": "20秒"
											},
											{
												"value": "30",
												"label": "30秒"
											}
										],
										"help": "歌声なし・MP3で短い曲を生成します。"
									},
									{
										"fieldId": "uploadId",
										"label": "音声ファイル（WAV・4 MBまで）",
										"control": "upload",
										"help": "未選択なら1秒の無音サンプルで通信を確認します。文字起こしの品質は発話入りの音声で確認してください。",
										"when": {
											"key": "kindCode",
											"in": ["asr"]
										},
										"accept": ".wav,audio/wav"
									}
								],
								"prefill": {}
							},
							"requiresCleanDraft": "document:settings@1"
						}
					],
					"create": {
						"actionId": "start-custom",
						"fields": [
							{
								"fieldId": "targetId",
								"label": "サービス",
								"control": "select",
								"required": true,
								"optionsSource": "query:service-tests.targets@1"
							},
							{
								"fieldId": "text",
								"label": "入力する文",
								"control": "textarea",
								"maxLength": 4096,
								"help": "空欄の場合は短い挨拶で試します。"
							},
							{
								"fieldId": "comparison",
								"label": "比較する文",
								"control": "text",
								"maxLength": 4096
							},
							{
								"fieldId": "voice",
								"label": "声",
								"control": "text",
								"maxLength": 128
							},
							{
								"fieldId": "width",
								"label": "幅（画像）",
								"control": "number",
								"min": 100,
								"max": 1280
							},
							{
								"fieldId": "height",
								"label": "高さ（画像）",
								"control": "number",
								"min": 100,
								"max": 1280
							},
							{
								"fieldId": "format",
								"label": "画像の形式",
								"control": "select",
								"options": [
									{
										"value": "png",
										"label": "PNG"
									},
									{
										"value": "webp",
										"label": "WebP"
									}
								]
							},
							{
								"fieldId": "durationSeconds",
								"label": "長さ（秒・楽曲）",
								"control": "number",
								"min": 1,
								"max": 30
							}
						]
					}
				},
				{
					"source": "service-tests-runs",
					"title": "確認の履歴",
					"rowKey": "id",
					"columns": [
						{
							"key": "kindCode",
							"label": "種類コード"
						},
						{
							"key": "model",
							"label": "対象"
						},
						{
							"key": "targetId",
							"label": "対象ID"
						},
						{
							"key": "status",
							"label": "状態コード"
						},
						{
							"key": "statusLabel",
							"label": "状態"
						},
						{
							"key": "phase",
							"label": "段階"
						},
						{
							"key": "created",
							"label": "開始",
							"format": "text"
						},
						{
							"key": "ended",
							"label": "終了",
							"format": "text"
						},
						{
							"key": "error",
							"label": "エラー"
						},
						{
							"key": "text",
							"label": "結果"
						},
						{
							"key": "retryArtifact",
							"label": "再取得",
							"format": "boolean"
						},
						{
							"key": "preview",
							"label": "プレビュー",
							"format": "media"
						},
						{
							"key": "progress",
							"label": "進捗",
							"format": "number"
						},
						{
							"key": "revision",
							"label": "設定版",
							"format": "number"
						},
						{
							"key": "actualModel",
							"label": "実行モデル"
						},
						{
							"key": "previewAvailable",
							"label": "プレビュー",
							"format": "boolean"
						}
					],
					"rowActions": [
						{
							"actionId": "cancel",
							"confirm": "実行中の確認を中止します。",
							"when": {
								"key": "status",
								"in": ["running"]
							}
						},
						{
							"actionId": "retry-artifact",
							"when": {
								"key": "retryArtifact",
								"in": [true]
							}
						}
					],
					"refreshWhile": {
						"key": "status",
						"in": ["running"]
					}
				},
				{
					"source": "service-tests-health",
					"title": "Healthの結果",
					"rowKey": "targetId",
					"columns": [
						{
							"key": "name",
							"label": "サービス"
						},
						{
							"key": "model",
							"label": "モデル"
						},
						{
							"key": "state",
							"label": "状態"
						},
						{
							"key": "reason",
							"label": "内容"
						},
						{
							"key": "checkedAt",
							"label": "確認時刻",
							"format": "date"
						},
						{
							"key": "latencyMs",
							"label": "応答時間（ms）",
							"format": "number"
						}
					],
					"refreshWhile": {
						"key": "running",
						"in": [true]
					}
				}
			],
			"draftDependencies": ["document:settings@1"]
		}
	],
	"schemas": [
		{
			"kind": "schema",
			"id": "service-tests-start",
			"revision": 1,
			"schema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"targetId": {
						"type": "string",
						"maxLength": 150,
						"minLength": 1
					},
					"revision": {
						"type": "integer",
						"minimum": 0
					},
					"text": {
						"type": "string",
						"maxLength": 4096
					},
					"comparison": {
						"type": "string",
						"maxLength": 4096
					},
					"voice": {
						"type": "string",
						"maxLength": 128
					},
					"width": {
						"type": "integer",
						"minimum": 100,
						"maximum": 1280
					},
					"height": {
						"type": "integer",
						"minimum": 100,
						"maximum": 1280
					},
					"format": {
						"type": "string",
						"maxLength": 4,
						"enum": ["png", "webp"]
					},
					"seed": {
						"type": "integer"
					},
					"durationSeconds": {
						"type": "integer",
						"minimum": 1,
						"maximum": 30
					}
				},
				"required": ["targetId"]
			}
		},
		{
			"kind": "schema",
			"id": "service-tests-start",
			"revision": 2,
			"schema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"targetId": {
						"type": "string",
						"maxLength": 150,
						"minLength": 1
					},
					"revision": {
						"type": "integer",
						"minimum": 0
					},
					"text": {
						"type": "string",
						"maxLength": 4096
					},
					"comparison": {
						"type": "string",
						"maxLength": 4096
					},
					"voice": {
						"type": "string",
						"maxLength": 128
					},
					"width": {
						"type": "integer",
						"minimum": 100,
						"maximum": 1280
					},
					"height": {
						"type": "integer",
						"minimum": 100,
						"maximum": 1280
					},
					"format": {
						"type": "string",
						"maxLength": 4,
						"enum": ["png", "webp"]
					},
					"seed": {
						"type": "integer"
					},
					"durationSeconds": {
						"type": "integer",
						"minimum": 1,
						"maximum": 30
					},
					"uploadId": {
						"type": "string",
						"minLength": 36,
						"maxLength": 36
					}
				},
				"required": ["targetId"]
			}
		},
		{
			"kind": "schema",
			"id": "service-tests-run",
			"revision": 1,
			"schema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"runId": {
						"type": "string",
						"maxLength": 36,
						"minLength": 36
					}
				},
				"required": ["runId"]
			}
		}
	]
}
