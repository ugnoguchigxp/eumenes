{
	"formatVersion": 1,
	"bundleId": "settings-world",
	"pins": [],
	"definitions": [],
	"bindings": [],
	"artifacts": [
		{
			"kind": "artifact",
			"id": "settings.world",
			"revision": 1,
			"title": "World",
			"variants": [
				{
					"id": "standard",
					"label": "標準",
					"definition": {
						"view": "layout",
						"direction": "stack",
						"title": "World",
						"children": [
							{
								"view": "collection-workspace",
								"source": "world-status",
								"title": "Worldの状態"
							},
							{
								"view": "collection-workspace",
								"source": "world-claims",
								"title": "主張の一覧"
							},
							{
								"view": "collection-workspace",
								"source": "world-forgets",
								"title": "忘却の状況"
							}
						]
					}
				}
			],
			"defaultVariant": "standard",
			"sourceBindings": [
				{
					"source": "world-status",
					"adapterRef": "adapter:world@1",
					"query": "query:world.status@1",
					"target": "none"
				},
				{
					"source": "world-claims",
					"adapterRef": "adapter:world@1",
					"query": "query:world.claims@1",
					"target": "none"
				},
				{
					"source": "world-forgets",
					"adapterRef": "adapter:world@1",
					"query": "query:world.forgets@1",
					"target": "none"
				},
				{
					"source": "world-reason-messages",
					"adapterRef": "adapter:world@1",
					"query": "query:world.reason-messages@1",
					"target": "none"
				}
			],
			"actionBindings": [
				{
					"actionId": "correct",
					"eventAction": "world-correct",
					"source": "world-claims",
					"inputSchemaRef": "schema:world-claim-correct@1",
					"effect": "write",
					"operationId": "world.correct",
					"label": "訂正する",
					"rowInput": {
						"claimId": "$row.id",
						"expectedRevision": "$row.revision"
					}
				},
				{
					"actionId": "retract",
					"eventAction": "world-retract",
					"source": "world-claims",
					"inputSchemaRef": "schema:world-claim-retract@1",
					"effect": "write",
					"operationId": "world.retract",
					"label": "撤回する",
					"rowInput": {
						"claimId": "$row.id",
						"expectedRevision": "$row.revision"
					}
				},
				{
					"actionId": "forget",
					"eventAction": "world-forget",
					"source": "world-claims",
					"inputSchemaRef": "schema:world-claim-forget@1",
					"effect": "write",
					"operationId": "world.forget",
					"label": "忘れる",
					"rowInput": {
						"claimId": "$row.id",
						"expectedRevision": "$row.revision"
					}
				}
			],
			"collections": [
				{
					"source": "world-status",
					"title": "Worldの状態",
					"rowKey": "id",
					"rowsPath": "items",
					"columns": [
						{
							"key": "state",
							"label": "状態",
							"format": "badge"
						},
						{
							"key": "gateOpen",
							"label": "Scopeの受付",
							"format": "boolean"
						},
						{
							"key": "claimsNote",
							"label": "主張の一覧の状況",
							"format": "text"
						},
						{
							"key": "forgetsNote",
							"label": "忘却の状況の読み取り",
							"format": "text"
						}
					]
				},
				{
					"source": "world-claims",
					"title": "主張の一覧",
					"rowKey": "id",
					"rowsPath": "items",
					"columns": [
						{
							"key": "subject",
							"label": "対象",
							"format": "text"
						},
						{
							"key": "claim",
							"label": "主張",
							"format": "text"
						},
						{
							"key": "toneLabel",
							"label": "採用状態",
							"format": "badge"
						},
						{
							"key": "originLabel",
							"label": "由来",
							"format": "text"
						},
						{
							"key": "freshnessLabel",
							"label": "鮮度",
							"format": "text"
						},
						{
							"key": "condition",
							"label": "条件",
							"format": "text"
						},
						{
							"key": "supports",
							"label": "支持する根拠",
							"format": "text"
						},
						{
							"key": "refutations",
							"label": "反証",
							"format": "text"
						},
						{
							"key": "sourceVersions",
							"label": "出典の版",
							"format": "text"
						},
						{
							"key": "history",
							"label": "履歴",
							"format": "text"
						},
						{
							"key": "revision",
							"label": "版",
							"format": "number"
						}
					],
					"rowActions": [
						{
							"actionId": "correct",
							"when": {
								"key": "correctable",
								"in": [true]
							},
							"form": {
								"fields": [
									{
										"fieldId": "reasonMessageId",
										"label": "理由にする、あなたの発言",
										"help": "変更を明示した本人の発言を選びます。",
										"control": "select",
										"optionsSource": "query:world.reason-messages@1",
										"required": true
									},
									{
										"fieldId": "valueKind",
										"label": "新しい値の種類",
										"control": "select",
										"required": true,
										"options": [
											{
												"value": "string",
												"label": "文字"
											},
											{
												"value": "boolean",
												"label": "真偽（true または false）"
											},
											{
												"value": "number",
												"label": "数値"
											}
										]
									},
									{
										"fieldId": "value",
										"label": "新しい値",
										"control": "text",
										"maxLength": 1000,
										"required": true,
										"help": "真偽は true か false、数値は半角の数字で入力します。"
									},
									{
										"fieldId": "unit",
										"label": "単位（数値のとき）",
										"control": "text",
										"maxLength": 40
									}
								],
								"prefill": {}
							}
						},
						{
							"actionId": "retract",
							"form": {
								"fields": [
									{
										"fieldId": "reasonMessageId",
										"label": "理由にする、あなたの発言",
										"help": "変更を明示した本人の発言を選びます。",
										"control": "select",
										"optionsSource": "query:world.reason-messages@1",
										"required": true
									}
								],
								"prefill": {}
							}
						},
						{
							"actionId": "forget",
							"confirm": "この主張を、これまでの版もすべて忘れます。受け付けた時点では完了ではなく、完了は「忘却の状況」で確認します。よろしいですか？"
						}
					]
				},
				{
					"source": "world-forgets",
					"title": "忘却の状況",
					"rowKey": "forgetId",
					"rowsPath": "items",
					"columns": [
						{
							"key": "displayLabel",
							"label": "状況",
							"format": "badge"
						},
						{
							"key": "rootCount",
							"label": "対象数",
							"format": "number"
						},
						{
							"key": "createdAt",
							"label": "受付",
							"format": "date"
						},
						{
							"key": "updatedAt",
							"label": "更新",
							"format": "date"
						},
						{
							"key": "blocked",
							"label": "保留の理由",
							"format": "text"
						}
					],
					"refreshWhile": {
						"key": "inProgress",
						"in": [true]
					}
				}
			],
			"launcher": {
				"label": "World",
				"group": "管理と確認",
				"order": 90,
				"description": "Worldが覚えている主張 訂正 撤回 忘却の状況"
			}
		}
	],
	"schemas": [
		{
			"kind": "schema",
			"id": "world-claim-correct",
			"revision": 1,
			"schema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"claimId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"expectedRevision": {
						"type": "integer",
						"minimum": 1
					},
					"reasonMessageId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"valueKind": {
						"type": "string",
						"enum": ["string", "boolean", "number"]
					},
					"value": {
						"type": "string",
						"minLength": 1,
						"maxLength": 1000
					},
					"unit": {
						"type": "string",
						"maxLength": 40
					}
				},
				"required": [
					"claimId",
					"expectedRevision",
					"reasonMessageId",
					"valueKind",
					"value"
				]
			}
		},
		{
			"kind": "schema",
			"id": "world-claim-retract",
			"revision": 1,
			"schema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"claimId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"expectedRevision": {
						"type": "integer",
						"minimum": 1
					},
					"reasonMessageId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					}
				},
				"required": ["claimId", "expectedRevision", "reasonMessageId"]
			}
		},
		{
			"kind": "schema",
			"id": "world-claim-forget",
			"revision": 1,
			"schema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"claimId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"expectedRevision": {
						"type": "integer",
						"minimum": 1
					}
				},
				"required": ["claimId", "expectedRevision"]
			}
		}
	]
}
