					"group": "speech",
					"options": [
						{
							"value": "",
							"label": "サービスの既定のキャラクター"
						}
					],
					"searchable": true,
					"visibleWhen": "condition:settings.speech-local@1"
				},
				{
					"fieldId": "larm.speech-style",
					"document": "document:settings@1",
					"path": "$.larm.style",
					"label": "話し方（スタイル）",
					"control": "select",
					"group": "speech",
					"options": [
						{
							"value": "",
							"label": "サービスの標準"
						}
					],
					"detail": true,
					"unset": "delete-key",
					"visibleWhen": "condition:settings.larm-style@1"
				},
				{
					"fieldId": "larm.speech-speed",
					"document": "document:settings@1",
					"path": "$.larm.speed",
					"label": "話す速さ",
					"control": "range",
					"group": "speech",
					"defaultValue": "1",
					"min": 0.5,
					"max": 2,
					"step": 0.1,
					"visibleWhen": "condition:settings.larm-speed@1"
				},
				{
					"fieldId": "larm.speech-pitch",
					"document": "document:settings@1",
