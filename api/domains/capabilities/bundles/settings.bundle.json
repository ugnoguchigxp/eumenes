				},
				{
					"fieldId": "resource.speed",
					"document": "document:settings@1",
					"path": "$.resources[id=$target].speed",
					"label": "話す速さ",
					"control": "range",
					"group": "speech",
					"defaultValue": "1",
					"min": 0.5,
					"max": 2,
					"step": 0.1,
					"target": "settings-tts-resources"
