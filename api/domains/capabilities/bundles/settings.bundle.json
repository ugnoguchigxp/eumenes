				},
				{
					"fieldId": "input.threshold",
					"document": "document:settings@1",
					"path": "$.voice.threshold",
					"label": "声を検出するしきい値",
					"control": "number",
					"group": "input",
					"detail": true,
					"min": 0.001,
					"max": 0.1,
					"step": 0.001,
					"help": "小さい値ほど小さな声を拾います。"
				},
				{
					"fieldId": "input.silence",
					"document": "document:settings@1",
					"path": "$.voice.silenceMs",
					"label": "発話を確定する無音時間（ミリ秒）",
					"control": "number",
					"group": "input",
					"detail": true,
					"min": 300,
					"max": 3000,
					"step": 100,
					"help": "標準は1500ミリ秒（1.5秒）です。"
				},
				{
					"fieldId": "input.echo-cancellation",
					"document": "document:settings@1",
					"path": "$.voice.echoCancellation",
					"label": "エコーを抑える",
