					"control": "range",
					"group": "particles",
					"defaultValue": "100",
					"min": 0,
					"max": 200,
					"step": 1,
					"help": "元の粒子座標から段階的に拡散します。100%が監視銀河の基準です。"
				},
				{
					"fieldId": "spatial.core",
					"document": "document:settings@1",
					"path": "$.general.spatialCore",
					"label": "元の形を残す割合（%）",
					"control": "range",
					"group": "particles",
					"defaultValue": "40",
					"min": 10,
					"max": 90,
					"step": 1
				},
				{
					"fieldId": "spatial.focus-core",
					"document": "document:settings@1",
					"path": "$.general.spatialFocusCore",
					"label": "フォーカス時に形を残す割合（%）",
					"control": "range",
					"group": "particles",
					"defaultValue": "60",
					"min": 10,
					"max": 90,
					"step": 1
				},
