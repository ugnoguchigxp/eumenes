					"fieldId": "appearance.subtitle-size",
					"document": "document:settings@1",
					"path": "$.general.subtitles.size",
					"label": "字幕の大きさ",
					"control": "select",
					"options": [
						{
							"value": "medium",
							"label": "中"
						},
						{
							"value": "large",
							"label": "大"
						},
						{
							"value": "xlarge",
							"label": "特大"
						}
					],
					"group": "subtitles"
				},
				{
					"fieldId": "spatial.scatter",
					"document": "document:settings@1",
					"path": "$.general.spatialScatter",
