				},
				{
					"actionId": "save",
					"eventAction": "usage-rate-save",
					"source": "usage",
					"inputSchemaRef": "schema:usage-rate@1",
					"effect": "write",
					"operationId": "usage.rate-save"
				}
			],
			"launcher": {
				"label": "利用状況",
				"description": "Liveの利用時間・概算費用とCodex SDKのモデル別利用量",
				"order": 85
			}
		}
