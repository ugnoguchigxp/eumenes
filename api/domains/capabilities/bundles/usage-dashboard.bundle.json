				"type": "object",
				"additionalProperties": false,
				"properties": {
					"start": {
						"type": "string"
					},
					"end": {
						"type": "string"
					},
					"service": {
						"type": "string",
						"enum": ["all", "live", "codex"]
					},
					"model": {
						"type": "string",
						"maxLength": 200
					},
					"connectionId": {
						"type": "string",
						"maxLength": 200
					},
					"pageIndex": {
						"type": "string",
						"maxLength": 6
