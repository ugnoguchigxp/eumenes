					"end": {
						"type": "string"
					},
					"service": {
						"type": "string",
						"enum": ["all", "live", "codex"]
					},
					"model": {
						"type": "string",
						"maxLength": 200
					},
					"connectionId": {
						"type": "string",
						"maxLength": 200
					},
					"pageIndex": {
						"type": "integer",
						"minimum": 0,
						"maximum": 100000
