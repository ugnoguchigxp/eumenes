{
	"view": "layout",
	"direction": "stack",
	"gap": "normal",
	"appearance": "friendly",
	"title": "豆の注文デモ",
	"model": {
		"state": {
			"p1": {
				"type": "number",
				"initial": 1280
			},
			"p2": {
				"type": "number",
				"initial": 1480
			},
			"p3": {
				"type": "number",
				"initial": 2200
			},
			"q1": {
				"type": "number",
				"initial": 1,
				"min": 0,
				"max": 10,
				"step": 1
			},
			"q2": {
				"type": "number",
				"initial": 0,
				"min": 0,
				"max": 10,
				"step": 1
			},
			"q3": {
				"type": "number",
				"initial": 0,
				"min": 0,
				"max": 10,
				"step": 1
			},
			"gift": {
				"type": "boolean",
				"initial": false
			}
		},
		"computed": {
			"subtotal": "p1 * q1 + p2 * q2 + p3 * q3",
			"shipping": "subtotal == 0 || subtotal >= 5000 ? 0 : 500",
			"wrapping": "gift ? 300 : 0",
			"total": "subtotal + shipping + wrapping",
			"count": "q1 + q2 + q3"
		}
	},
