		},
		{
			"view": "layout",
			"direction": "grid",
			"gap": "normal",
			"children": [
				{
					"view": "info-card",
					"title": "所要時間",
					"body": "約2分"
				},
				{
					"view": "info-card",
					"title": "回答方法",
