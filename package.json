{
	"name": "eumenes",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun api/application/server.ts",
		"dev": "vite --host 127.0.0.1",
		"cli": "bun cli/index.ts",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --deny-warnings --fix",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"verify": "bun scripts/verify.ts",
		"test:domain": "bun scripts/test-domain.ts",
		"verify:all": "bun scripts/verify.ts --all",
		"verify:live": "bun scripts/verify-live.ts",
		"build:web": "vite build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tanstack/react-query": "5.101.0",
		"hono": "4.12.34",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"zod": "4.4.3",
		"zustand": "5.0.8"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"jsdom": "29.1.1",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vitest": "4.1.8"
	}
}
