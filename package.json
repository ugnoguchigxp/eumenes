{
	"name": "eumenes",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"start": "bun api/application/server.ts",
		"dev": "bun scripts/dev.ts",
		"dev:web": "vite --host 127.0.0.1 --strictPort",
		"cli": "bun cli/index.ts",
		"logs": "bun scripts/logs.ts",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --deny-warnings --fix",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"verify": "bun scripts/verify.ts",
		"size:check": "bun scripts/size-budget.ts",
		"bundle:check": "bun scripts/bundle-budget.ts",
		"docs:domains": "bun scripts/domain-docs.ts",
		"test:domain": "bun scripts/test-domain.ts",
		"test:inventory": "bun scripts/test-inventory.ts",
		"verify:metrics": "bun scripts/verification-metrics.ts",
		"test:search": "bun test api/domains/dialogue/test/toolchain-tools.test.ts api/domains/agent-runtime/test/context.test.ts api/application/toolchain/search-agents-check.test.ts",
		"test:search:live": "bun scripts/search-agents-live.ts --run",
		"verify:all": "bun scripts/verify.ts --all",
		"verify:live": "bun scripts/verify-live.ts",
		"context:eval": "bun scripts/context-eval/cli.ts",
		"nl-acceptance": "bun scripts/nl-acceptance.ts",
		"toolchain:bundle": "bun scripts/toolchain-bundle.ts",
		"decision:bench": "python3 -B scripts/decision-bench/bench.py",
		"decision:bench:check": "python3 -B scripts/decision-bench/bench.py self-test",
		"build:design-system": "cd packages/design-system && bun run build",
		"postinstall": "bun scripts/build-design-system.ts",
		"build:web": "bun run build:design-system && vite build",
		"typecheck": "bun check",
		"deadcode": "knip --include exports,types",
		"context:lint": "s11tnext lint --release-profile application",
		"context:build": "s11tnext build --release-profile application",
		"context:check": "s11tnext build --check --release-profile application"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.289",
		"@anthropic-ai/sdk": "0.131.0",
		"@eumenes/artifact-ui": "workspace:*",
		"@eumenes/design-system": "workspace:*",
		"@excalidraw/excalidraw": "0.18.1",
		"@openai/codex-sdk": "0.160.0",
		"@playwright/mcp": "0.0.83",
		"@tanstack/react-query": "5.101.0",
		"bmp-ts": "1.0.9",
		"eumenes-agency": "file:vendor/agency/eumenes-agency-0.0.1-92c4a2bc4c4e.tgz",
		"eumenes-memory": "file:vendor/eumenes-memory/eumenes-memory-0.0.2-6643656f3383.tgz",
		"eumenes-world-model": "file:vendor/world/eumenes-world-model-0.0.1.tgz",
		"google-auth-library": "11.1.0",
		"hono": "4.12.34",
		"jsonrepair": "3.15.0",
		"llm-fetch": "0.1.4",
		"pino": "10.3.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "7.71.0",
		"s11tnext": "0.1.2",
		"sharp": "0.35.5",
		"three": "0.186.1",
		"zod": "4.4.3",
		"zustand": "5.0.8"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/three": "0.186.0",
		"@vitejs/plugin-react": "6.0.2",
		"jsdom": "29.1.1",
		"knip": "6.38.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"s11tnext-cli": "0.1.2",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vitest": "4.1.8"
	}
}
