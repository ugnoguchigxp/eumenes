{
	"name": "eumenes",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"start": "bun api/application/server.ts",
		"dev": "bun scripts/dev.ts",
		"dev:web": "vite --host 127.0.0.1 --strictPort",
		"cli": "bun cli/index.ts",
		"logs": "bun scripts/logs.ts",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --deny-warnings --fix",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"verify": "bun scripts/verify.ts",
		"size:check": "bun scripts/size-budget.ts",
		"docs:domains": "bun scripts/domain-docs.ts",
		"test:domain": "bun scripts/test-domain.ts",
		"verify:all": "bun scripts/verify.ts --all",
		"verify:live": "bun scripts/verify-live.ts",
		"decision:bench": "python3 -B scripts/decision-bench/bench.py",
		"decision:bench:check": "python3 -B scripts/decision-bench/bench.py self-test",
		"build:design-system": "cd packages/design-system && bun run build",
		"postinstall": "bun scripts/build-design-system.ts",
		"build:web": "bun run build:design-system && vite build",
		"typecheck": "tsc --noEmit",
		"deadcode": "knip --include exports,types"
	},
	"dependencies": {
		"@eumenes/design-system": "workspace:*",
		"@tanstack/react-query": "5.101.0",
		"eumenes-memory": "file:vendor/eumenes-memory/eumenes-memory-0.3.6.tgz",
		"eumenes-world-model": "file:vendor/world/eumenes-world-model-0.0.0.tgz",
		"hono": "4.12.34",
		"llm-fetch": "0.1.2",
		"pino": "10.3.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "7.71.0",
		"three": "0.186.1",
		"zod": "4.4.3",
		"zustand": "5.0.8",
		"@eumenes/artifact-ui": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"jsdom": "29.1.1",
		"knip": "6.38.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vitest": "4.1.8"
	}
}
