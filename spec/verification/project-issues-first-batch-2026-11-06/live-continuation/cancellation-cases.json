        {
          "ref": "t2.answer",
          "work": "台所のタイマーを作る",
          "state": "asking",
          "question": "何秒にしますか？"
        },
        {
          "ref": "t3.answer",
          "work": "運動のタイマーを作る",
          "state": "asking",
          "question": "何秒にしますか？"
        }
      ],
      "expected": {
        "to": "control",
        "ref": "t3.cancel",
        "forbidden": [
          "t2の取消",
          "新規TODO作成"
        ]
      }
    },
    {
      "id": "cancel-ambiguous",
      "split": "dev",
      "origin": "synthetic",
      "input": "その作業は取り消してください。",
      "pending": [
        {
          "ref": "t2.answer",
          "work": "タイマーを作る",
          "state": "asking",
          "question": "何秒にしますか？"
        },
        {
          "ref": "t3.answer",
          "work": "タイマーを作る",
          "state": "asking",
          "question": "何秒にしますか？"
        }
      ],
      "expected": {
        "to": "clarify",
        "forbidden": [
