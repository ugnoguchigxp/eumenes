      "split": "dev",
      "origin": "synthetic",
      "input": "作業を取り消すと何が起きるのか説明してください。",
      "pending": [
        {
          "ref": "t2.answer",
          "work": "タイマーを作る",
          "state": "asking",
          "question": "何秒にしますか？"
        }
      ],
      "expected": {
