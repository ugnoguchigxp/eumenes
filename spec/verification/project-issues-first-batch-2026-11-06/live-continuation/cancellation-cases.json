{
  "version": 1,
  "date": "2026-11-06",
  "scope": "合意済み取消契約の実モデル比較。モデルへの初送信前に固定。",
  "cases": [
    {
      "id": "cancel-one",
      "split": "dev",
      "origin": "synthetic",
      "input": "その作業はもう不要なので取り消してください。",
      "pending": [
        {
          "ref": "t2.answer",
          "work": "タイマーを作る",
          "state": "asking",
          "question": "何秒にしますか？"
        }
      ],
      "expected": {
        "to": "control",
        "ref": "t2.cancel",
        "forbidden": [
          "新規TODO作成",
          "回答扱い"
        ]
      }
    },
    {
      "id": "cancel-specific-two",
      "split": "dev",
      "origin": "synthetic",
      "input": "運動のタイマーを作る作業は中止してください。",
