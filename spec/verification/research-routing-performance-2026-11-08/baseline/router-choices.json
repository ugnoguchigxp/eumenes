  "cards": [
    {
      "id": "web.research",
      "kind": "dedicated",
      "name": "詳しいWeb調査",
      "description": "複数の公式資料・一次資料をWebで読み比べ、条件や制約、共通点と相違点、矛盾を出典付きで整理する。複数の論点を一つの調査として扱い、仮説と反証を検証しながら考察を深め、不明点を明記した報告を作る。調査結果はタイトル付きMarkdown文書にまとめ、一時ファイルと利用可能なDoclingのEumenes専用領域へ新規保存する",
      "useWhen": [
        "複数の資料の本文を照合し、条件・制約・限界を比較して根拠付きでまとめてほしい",
        "相反する情報や競合する説明を一次資料に当たって検証したい",
        "複数の問いを関連付け、調査方針や仮説を見直しながら掘り下げたい"
      ],
      "avoidWhen": [
        "定義・人物・指定URLの一項目など短い事実確認",
        "専用担当で完結する天気・株価・ニュースの取得",
        "既存文書の変更、公開、他者への送信"
      ],
      "examples": [
