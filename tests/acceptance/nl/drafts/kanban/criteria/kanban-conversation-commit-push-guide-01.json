					{
						"id": "button",
						"patterns": ["commit.{0,4}push|コミット.{0,6}プッシュ"]
					},
					{
						"id": "press",
						"patterns": ["押|ボタン|確認"]
					}
				],
				"forbidden": [
					{
						"id": "done-claim",
						"patterns": [
							"pushしました|push しました|プッシュしました|コミットしました"
