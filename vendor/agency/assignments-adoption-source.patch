+function readyOrNeedsUser(
+	criteria: GoalProgressState["criteria"],
+	questions: readonly GoalQuestion[],
+): GoalPhase {
+	const blocked = goalOwnerQuestionCriteria(questions, criteria);
+	return blocked.size &&
+		!criteria.some(({ id, status }) => status === "open" && !blocked.has(id))
