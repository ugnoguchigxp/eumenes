+		},
+		register: (
+			slot: number | null,
+			input: Parameters<typeof store.register>[2],
+		) => store.register(access(), slot, input),
+		revise: (
+			target: Parameters<typeof store.revise>[1],
+			input: Parameters<typeof store.revise>[2],
