+import { createHash } from "node:crypto";
+import { z } from "zod";
+import { asData, type KnownItem } from "../../src/agenda/index.ts";
+import type { NoteDoc } from "./docs.ts";
+import type { StoredGoal } from "./goal-store.ts";
