+					phase: "observing",
+					currentWorkId: attemptId,
+					state: {
+						...progress.state,
+						next: attempt.step,
+						watch: null,
+						lastDecision: {
+							contextId: attempt.step.contextId,
+							digest: contentDigest(attempt.step),
+							resultRef: attempt.id,
+						},
+					},
+				});
