+				}
+				if (!options.current(db, progress, null))
+					return { status: "forbidden" };
+			}
+			const state = withEvidence(progress.state, observation.evidence ?? []);
+			const next = advance(db, progress, {
+				phase,
+				currentWorkId: work,
+				dueAtMs: retainSchedule
