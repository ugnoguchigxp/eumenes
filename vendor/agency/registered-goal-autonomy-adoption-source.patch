+					checkRef: string;
+					passed: boolean;
+					evidence: GoalEvidence;
+				}[];
+				readonly current: (db: Database, progress: GoalProgress) => boolean;
+			},
+		) {
+			const progress = active(db, access, key);
+			const step = progress?.state.next;
+			if (
+				!progress ||
+				progress.phase !== "verifying" ||
+				step?.kind !== "verify" ||
