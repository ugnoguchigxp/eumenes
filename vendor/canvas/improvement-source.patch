@@ -0,0 +1,68 @@
+import { expect, test } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { CanvasService } from "../../src/core/service";
+import { Store } from "../../src/core/store";
+import { HostReviewer } from "../../src/core/host-reviewer";
+import { FakeObserver } from "./support";
+import { report } from "./probe-fixtures";
+
+const output = { body: { title: "fixture", entry: "canvasApp.start(() => ({}));" }, changes: "", unconfirmed: [], reply: "", spec: { requirements: ["入力応答"], controls: [] } };
+
+test.each(["cancel", "expiry", "failure"] as const)("判定開始後の%sでも推論2回を永続記録する", async (end) => {
+  const dir = mkdtempSync(join(tmpdir(), "canvas-accounting-"));
+  let now = 1, calls = 0;
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  const reviewer = new HostReviewer({ suite: "fixture", async probe() { return report(); }, async runScripts() { return []; }, async close() {} },
+    { label: "fixture", async plan() { throw new Error("unused"); }, async judge() { calls++; entered.resolve(); await release.promise; return { verdicts: [], issues: [], summary: "" }; } });
+  const service = new CanvasService({ store: new Store(dir), model: { label: "fixture", async generate() { return structuredClone(output); } }, observer: new FakeObserver(), contract: "fixture", now: () => now, review: { mode: "judge", reviewer } });
+  try {
+    const run = await service.startRun("owner", "session", { message: "request", modelCallLimit: 2 });
+    await entered.promise;
+    if (end === "cancel") await service.cancelRun("owner", run.id);
+    if (end === "expiry") now = run.deadline + 1;
+    if (end === "failure") release.reject(new Error("fixture judge failure")); else release.resolve();
+    await service.drain();
+    const result = service.getRun("owner", run.id);
+    expect(calls).toBe(1);
+    expect(result.modelCalls).toBe(2);
+    expect(result.state).toBe(end === "cancel" ? "cancelled" : end === "expiry" ? "expired" : "presented");
+    const stored = new Store(dir).runs[run.id];
+    expect(stored.modelCalls).toBe(2);
+    expect(stored.modelCallIds).toEqual(["maker:0", "review:0:judge"]);
+  } finally { release.resolve(); await service.close(); rmSync(dir, { recursive: true, force: true }); }
+});
+
+test("観測中に取り消したときは、開始していない判定を数えない", async () => {
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>(); let calls = 0;
+  const reviewer = new HostReviewer({ suite: "fixture", async probe() { entered.resolve(); await release.promise; return report(); }, async runScripts() { return []; }, async close() { release.resolve(); } },
+    { label: "fixture", async plan() { throw new Error("unused"); }, async judge() { calls++; return { verdicts: [] }; } });
+  const service = new CanvasService({ store: new Store(null), contract: "fixture", model: { label: "fixture", async generate() { return structuredClone(output); } }, observer: new FakeObserver(), review: { mode: "judge", reviewer } });
+  try {
+    const run = await service.startRun("owner", "session", { message: "request" });
+    await entered.promise; await service.cancelRun("owner", run.id); release.resolve(); await service.drain();
+    expect(calls).toBe(0); expect(service.getRun("owner", run.id).modelCalls).toBe(1);
+  } finally { release.resolve(); await service.close(); }
+});
+
+test("呼出開始の通知は冪等で、候補保存時に二重計上しない", async () => {
+  const service = new CanvasService({ store: new Store(null), contract: "fixture", model: { label: "fixture", async generate() { return structuredClone(output); } }, observer: new FakeObserver(),
+    review: { mode: "judge", reviewer: { suite: "fixture", async review(_input, _signal, before) { await before!("judge"); await before!("judge"); return { suite: "fixture", environment: "fixture", checks: [], findings: [], verdict: null, evaluatorCalls: 1, ms: 0, error: null }; }, async close() {} } } });
+  try {
+    const run = await service.startRun("owner", "session", { message: "request", modelCallLimit: 2 }); await service.drain();
+    expect(service.getRun("owner", run.id)).toMatchObject({ state: "presented", modelCalls: 2 });
+  } finally { await service.close(); }
+});
+
+test("計上を書き込めなければ判定を開始しない", async () => {
+  const store = new Store(null); const write = store.write.bind(store);
+  let calls = 0;
+  const reviewer = new HostReviewer({ suite: "fixture", async probe() { store.write = async () => { throw new Error("fixture ledger write failure"); }; return report(); }, async runScripts() { return []; }, async close() {} },
+    { label: "fixture", async plan() { throw new Error("unused"); }, async judge() { calls++; return { verdicts: [] }; } });
+  const service = new CanvasService({ store, contract: "fixture", model: { label: "fixture", async generate() { return structuredClone(output); } }, observer: new FakeObserver(), review: { mode: "judge", reviewer } });
+  try {
+    const run = await service.startRun("owner", "session", { message: "request" }); await service.drain();
+    expect(calls).toBe(0); expect(service.getRun("owner", run.id).modelCalls).toBe(1);
+  } finally { store.write = write; await service.close(); }
+});
diff --git a/tests/unit/production-regressions.test.ts b/tests/unit/production-regressions.test.ts
