+++ b/tests/unit/production-regressions.test.ts
@@ -0,0 +1,138 @@
+import { expect, test } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { CanvasService } from "../../src/core/service";
+import { Store } from "../../src/core/store";
+import { ArtworkCatalog } from "../../src/core/artwork-catalog";
+import { compareInputRuns } from "../../src/core/observer";
+import { FakeObserver } from "./support";
+
+function fixture(dataDir: string | null = null) {
+  let calls = 0;
+  const store = new Store(dataDir);
+  const service = new CanvasService({ store, contract: "contract", observer: new FakeObserver(), model: { label: "fixture", async generate(input) {
+    calls++;
+    return { body: { title: input.request, entry: "canvasApp.start(() => ({}));" }, changes: "", unconfirmed: [], reply: "" };
+  } } });
+  async function save(message: string, artworkId?: string, expectedRevision = 0) {
+    const run = await service.startRun("owner", "s-" + message, { message, artworkId });
+    await service.drain();
+    const completed = service.getRun("owner", run.id);
+    return (await service.save("owner", completed.presentedCandidateId!, { expectedRevision, idempotencyKey: "save_" + message })).result as { artworkId: string; revision: number; digest: string };
+  }
+  return { store, service, save, calls: () => calls };
+}
+
+test("受付キーの同時再送は一つのrunだけを作り、別入力の再送は拒否する", async () => {
+  const f = fixture();
+  try {
+    const req = { message: "new_work", requestKey: "host-request" };
+    const runs = await Promise.all([f.service.startRun("owner", "session", req), f.service.startRun("owner", "session", req)]);
+    await f.service.drain();
+    expect(runs[0].id).toBe(runs[1].id);
+    expect(f.calls()).toBe(1);
+    await expect(f.service.startRun("owner", "session", { ...req, message: "other" })).rejects.toMatchObject({ status: 409, extra: { code: "request-conflict" } });
+    expect(f.service.findRunByRequest("other-owner", req.requestKey)).toBeNull();
+  } finally { await f.service.close(); }
+});
+
+test("受付した編集元が変わると、制作推論を呼ぶ前に競合を返す", async () => {
+  const f = fixture();
+  try {
+    const first = await f.save("revision_one");
+    await f.save("revision_two", first.artworkId, 1);
+    const calls = f.calls();
+    await expect(f.service.startRun("owner", "edit", { message: "edit", artworkId: first.artworkId, expectedBase: { revision: 1, digest: first.digest } })).rejects.toMatchObject({ status: 409, extra: { code: "conflict", currentRevision: 2 } });
+    expect(f.calls()).toBe(calls);
+  } finally { await f.service.close(); }
+});
+
+test("生成中に参照が失効した場合、遅い結果を候補として採用しない", async () => {
+  let valid = true;
+  const reply = Promise.withResolvers<void>();
+  const entered = Promise.withResolvers<void>();
+  const service = new CanvasService({ store: new Store(null), contract: "contract", observer: new FakeObserver(), model: { label: "fixture", async generate() { entered.resolve(); await reply.promise; return { body: { title: "fixture", entry: "canvasApp.start(() => ({}));" }, changes: "", unconfirmed: [], reply: "" }; } } });
+  try {
+    const run = await service.startRun("owner", "session", { message: "request" }, () => valid);
+    await entered.promise;
+    valid = false;
+    reply.resolve();
+    await service.drain();
+    expect(service.getRun("owner", run.id)).toMatchObject({ state: "cancelled", candidateIds: [] });
+  } finally { reply.resolve(); await service.close(); }
+});
+
+test("再起動した保存先から受付キーで失敗runを照会でき、再送で制作し直さない", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "canvas-request-recovery-"));
+  const first = fixture(dir);
+  try {
+    const run = await first.service.startRun("owner", "session", { message: "request", requestKey: "recover-request" });
+    await first.service.drain();
+    await first.store.write((commit) => commit(["runs"], (state) => { state.runs[run.id].state = "running"; }));
+    await first.service.close();
+    const recovered = fixture(dir);
+    try {
+      expect(recovered.service.findRunByRequest("owner", "recover-request")).toMatchObject({ id: run.id, state: "failed" });
+      expect((await recovered.service.startRun("owner", "session", { message: "request", requestKey: "recover-request" })).id).toBe(run.id);
+      expect(recovered.calls()).toBe(0);
+    } finally { await recovered.service.close(); }
+  } finally { await first.service.close(); rmSync(dir, { recursive: true, force: true }); }
+});
+
+test("古い作品へページと検索で到達し、対象の会話・有効期限・版を照合する", async () => {
+  const f = fixture();
+  try {
+    for (let n = 0; n < 26; n++) await f.save(`work_${String(n).padStart(2, "0")}`);
+    let now = 1;
+    const catalog = new ArtworkCatalog(f.service, () => now);
+    const first = catalog.page("owner", "conversation");
+    expect(first.artworks).toHaveLength(25);
+    expect(first.hasMore).toBe(true);
+    const second = catalog.page("owner", "conversation", { cursor: first.nextCursor! });
+    expect(new Set([...first.artworks, ...second.artworks].map((a) => a.artworkId)).size).toBe(26);
+    const [target] = catalog.page("owner", "conversation", { query: "work_00" }).artworks;
+    expect(catalog.resolve("owner", "conversation", target.targetRef).artworkId).toBe(target.artworkId);
+    expect(() => catalog.resolve("owner", "different", target.targetRef)).toThrow();
+    expect(catalog.page("owner", "conversation", { query: "absent" }).artworks).toEqual([]);
+    expect(catalog.snapshot("owner", "conversation").hasMore).toBe(false);
+    expect(() => catalog.page("owner", "conversation", { cursor: Buffer.from("null").toString("base64url") })).toThrow("ページ参照の形式");
+    await f.save("updated_work", target.artworkId, 1);
+    expect(() => catalog.resolve("owner", "conversation", target.targetRef)).toThrow("編集元の版");
+    expect(() => catalog.page("owner", "conversation", { cursor: first.nextCursor! })).toThrow("一覧が更新");
+    now += 180_001;
+    expect(() => catalog.resolve("owner", "conversation", first.artworks[0].targetRef)).toThrow("失効");
+  } finally { await f.service.close(); }
+});
+
+test("入力なしと同じ時間変化だけでは応答とせず、再現できる入力の差だけを採用する", () => {
+  const shot = (n: number) => ({ width: 1, height: 1, data: Uint8Array.of(n, 0, 0, 255) });
+  const baseline = [shot(0), shot(1), shot(2), shot(3)];
+  expect(compareInputRuns(baseline, baseline, baseline)).toEqual({ deterministic: true, responds: false });
+  expect(compareInputRuns([shot(0), shot(1), shot(8), shot(3)], baseline, baseline)).toEqual({ deterministic: true, responds: true });
+  expect(compareInputRuns([shot(0), shot(1), shot(8), shot(3)], baseline, [shot(0), shot(1), shot(9), shot(3)])).toEqual({ deterministic: false, responds: false });
+  expect(compareInputRuns(baseline, [], baseline).responds).toBe(false);
+});
+
+test("失敗した制作推論も呼出数へ数える", async () => {
+  const service = new CanvasService({ store: new Store(null), contract: "contract", observer: new FakeObserver(), model: { label: "fixture", async generate() { throw new Error("fixture_failure"); } } });
+  try {
+    const run = await service.startRun("owner", "session", { message: "request", modelCallLimit: 1 });
+    await service.drain();
+    expect(service.getRun("owner", run.id)).toMatchObject({ state: "failed", modelCalls: 1 });
+  } finally { await service.close(); }
+});
+
+test("親からの呼出予算を超えて生成・判定を続けない", async () => {
+  let makerCalls = 0, judgeCalls = 0;
+  const service = new CanvasService({ store: new Store(null), contract: "contract", observer: new FakeObserver(),
+    model: { label: "fixture", async generate() { makerCalls++; return { body: { title: "fixture", entry: "canvasApp.start(() => ({}));" }, changes: "", unconfirmed: [], reply: "" }; } },
+    review: { mode: "judge", reviewer: { suite: "fixture", async review(_input, _signal, beforeInference) { await beforeInference?.("judge"); judgeCalls++; return { suite: "fixture", environment: "fixture", checks: [], findings: [{ source: "evaluator", severity: "blocking", id: "fixture", message: "要修正" }], verdict: null, evaluatorCalls: 1, ms: 1, error: null }; }, async close() {} } },
+  });
+  try {
+    const run = await service.startRun("owner", "session", { message: "request", modelCallLimit: 2 });
+    await service.drain();
+    expect([makerCalls, judgeCalls]).toEqual([1, 1]);
+    expect(service.getRun("owner", run.id)).toMatchObject({ state: "presented", modelCalls: 2 });
+  } finally { await service.close(); }
+});
